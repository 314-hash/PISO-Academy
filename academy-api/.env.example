# PISO Academy API — MongoDB Backup Server

# ─── REQUIRED ─────────────────────────────────────────────────────────────────
# Your MongoDB Atlas connection string (from Atlas → Connect → Drivers)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://<db_username>:tetmbsbQvmh738Np@cluster01.vvq7myj.mongodb.net/?appName=Cluster01

# ─── OPTIONAL ─────────────────────────────────────────────────────────────────
# Port the API server listens on (frontend proxies to this)
PORT=4000

# Secret for signing API request tokens (generate: openssl rand -hex 32)
API_SECRET=change_this_to_a_random_secret_at_least_32_chars

# Frontend origin allowed by CORS (must match your dev/prod URL)
CORS_ORIGIN=http://localhost:5173
